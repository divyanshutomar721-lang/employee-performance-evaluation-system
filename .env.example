# EPES — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.

DB_URL=jdbc:postgresql://localhost:5432/epes
DB_USER=postgres
DB_PASSWORD=

# Optional bootstrap admin email (auto-created on startup if not present)
ADMIN_EMAIL=admin@epes.local

# Authentication mode (true for development email login; false when OAuth2 is enforced)
TEMP_LOGIN_ENABLED=true

# Goal deadline monitoring interval in minutes (default: 60)
GOAL_CHECK_INTERVAL_MINUTES=60
