<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${pageTitle != null ? pageTitle : 'EPES — Employee Performance Evaluation System'}"/></title>
    <meta name="description" content="Employee Performance Evaluation System">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YcnS/1DYZb5BjAo60FmBJLPic4G8gYTLfGn"
          crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet">
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">
    <!-- EPES Theme -->
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark navbar-epes sticky-top">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="${pageContext.request.contextPath}/home">
            <i class="bi bi-rocket-takeoff text-primary"></i>
            <span>EPES</span>
        </a>

        <c:choose>
            <c:when test="${not empty sessionScope.currentUser}">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#epesNav"
                        aria-controls="epesNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="epesNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" href="${pageContext.request.contextPath}/home">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3 text-light">
                        <div class="d-flex align-items-center gap-2">
                            <span class="small text-light fw-semibold">
                                <c:out value="${sessionScope.currentUser.fullName}"/>
                            </span>
                            <span class="badge bg-secondary">
                                <c:out value="${sessionScope.currentUser.role}"/>
                            </span>
                        </div>
                        <form method="post" action="${pageContext.request.contextPath}/logout" class="d-inline m-0">
                            <input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"/>
                            <button type="submit" class="btn btn-sm btn-outline-light">
                                <i class="bi bi-box-arrow-right me-1"></i> Sign out
                            </button>
                        </form>
                    </div>
                </div>
            </c:when>
            <c:otherwise>
                <div class="d-flex align-items-center gap-2">
                    <a href="${pageContext.request.contextPath}/login" class="btn btn-sm btn-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign in
                    </a>
                </div>
            </c:otherwise>
        </c:choose>
    </div>
</nav>

<main class="py-4">
    <div class="container">
        <c:if test="${not empty flashMessages}">
            <c:forEach items="${flashMessages}" var="msg">
                <div class="alert alert-<c:out value='${msg.bootstrapClass}'/> alert-dismissible fade show" role="alert">
                    <c:out value="${msg.text}"/>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </c:forEach>
        </c:if>
