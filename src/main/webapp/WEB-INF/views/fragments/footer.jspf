    </div><!-- /.container -->
</main>

<footer class="py-3 mt-auto">
    <div class="container text-center">
        <span>&copy; 2026 Employee Performance Evaluation System (EPES) &mdash; College Project</span>
    </div>
</footer>

<!-- Bootstrap 5 JS Bundle (Local) -->
<script src="${pageContext.request.contextPath}/assets/vendor/bootstrap.bundle.min.js"></script>

<!-- Conditional Chart.js and chart initializers -->
<c:if test="${needsCharts}">
    <script src="${pageContext.request.contextPath}/assets/vendor/chart.umd.js"></script>
    <script src="${pageContext.request.contextPath}/assets/js/charts.js"></script>
</c:if>
</body>
</html>
